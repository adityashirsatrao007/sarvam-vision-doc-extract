# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit a real .env, only .env.example
.env
.env.*
!.env.example

# Evaluation / extraction outputs (results/.gitkeep is tracked, nothing else)
results/*
!results/.gitkeep

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
