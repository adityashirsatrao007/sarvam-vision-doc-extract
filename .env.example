# sarvam-vision-doc-extract — OPTIONAL configuration.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# only this template is committed. No key is required for the default
# rule-based provider — it runs fully offline with zero dependencies.
#
# Used only by the optional LLM provider (`--provider llm`).
#   SARVAM_API_BASE: base URL of an OpenAI-compatible chat-completions endpoint.
#     VERIFY this against the current Sarvam API docs before use — the LLM
#     provider is wired but untested without a live key (see README, "Honest
#     limits").
SARVAM_API_KEY=
SARVAM_API_BASE=https://api.sarvam.ai/v1
VISION_MODEL=sarvam-m

# Optional: point the .env loader somewhere else instead of ./.env
# DOCEXTRACT_ENV_FILE=/path/to/.env
